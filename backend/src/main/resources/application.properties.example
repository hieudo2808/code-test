# ==================== APPLICATION ====================
spring.application.name=code-trials
server.port=8080

# ==================== DATABASE ====================
# SQL Server (default)
spring.datasource.url=${DB_URL:jdbc:sqlserver://localhost:17288;database=CodeTrials;encrypt=true;trustServerCertificate=true}
spring.datasource.username=${DB_USERNAME:sa}
spring.datasource.password=${DB_PASSWORD:your_db_password}
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
logging.level.com.example.app.controller.JudgeCallbackController=INFO

# PostgreSQL (uncomment if needed)
# spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/mydb}
# spring.datasource.username=${DB_USERNAME:postgres}
# spring.datasource.password=${DB_PASSWORD:your_password}
# spring.datasource.driver-class-name=org.postgresql.Driver

# ==================== JPA/HIBERNATE ====================
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# ==================== JWT CONFIGURATION ====================
jwt.secret=${JWT_SECRET:change_me_to_a_random_64_byte_base64_string}
jwt.expiration=${JWT_EXPIRATION:600000}
jwt.refresh-expiration=${JWT_REFRESH_EXPIRATION:604800000}

# ==================== SECURITY ====================
security.pepper=${SECURITY_PEPPER:change_me_to_a_random_base64_string}

# ==================== CORS ====================
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173}

# ==================== REDIS ====================
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}
spring.data.redis.ssl.enabled=${REDIS_SSL_ENABLED:false}

# ==================== ACTUATOR ====================
management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=when_authorized
management.health.mail.enabled=false

# ==================== LOGGING ====================
logging.level.root=INFO
logging.level.com.example=DEBUG
logging.level.org.springframework.security=INFO

# ==================== EMAIL ====================
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME:your_email@gmail.com}
spring.mail.password=${MAIL_PASSWORD:your_app_password}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true

# ==================== AWS S3 ====================
aws.s3.bucket=${AWS_S3_BUCKET:codetrials}
aws.s3.region=${AWS_S3_REGION:ap-southeast-1}
aws.accessKeyId=${AWS_ACCESS_KEY_ID:your_access_key}
aws.secretKey=${AWS_SECRET_KEY:your_secret_key}

# ==================== JUDGE0 ====================
judge0.base-url=${JUDGE0_BASE_URL:http://localhost:2358}
judge0.auth-token=${JUDGE0_AUTH_TOKEN:your_judge0_auth_token}
judge0.callback-url=${JUDGE0_CALLBACK_URL:http://host.docker.internal:8080/api/internal/judge/callback}

# Retry config
judge0.retry.max-attempts=3
judge0.retry.initial-delay-ms=2000
judge0.retry.multiplier=2.0

# Rate limiting
judge0.rate-limit.max-concurrent=10
judge0.rate-limit.queue-timeout-ms=30000
